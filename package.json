{
  "name": "forward",
  "version": "0.1.0",
  "private": true,
  "description": "Keep UI design and backend docs in sync \u2014 versioned in your git repo, editable by humans and AI agents.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bootstrap": "npm install && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsasante1/forward.git"
  },
  "allowScripts": {
    "@vscode/vsce-sign": false,
    "esbuild": true
  }
}
