{
  "name": "api-design-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, BYOD-Firebase alternative to Figma Code Connect: map API docs to an independent design canvas.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:canvas": "npm run dev --workspace apps/canvas",
    "mock": "npm run start --workspace apps/mock-rtdb",
    "seed:mock": "node apps/canvas/scripts/seed.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy:rules": "firebase deploy --only database",
    "bootstrap": "npm install && npm run build && npm run setup"
  },
  "devDependencies": {
    "firebase-tools": "^15.19.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
