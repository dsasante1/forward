{
  "name": "forward",
  "version": "0.1.0",
  "private": true,
  "description": "A developer-first tool: map API docs to an independent design canvas.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "setup": "node scripts/setup.mjs",
    "deploy:rules": "firebase deploy --only database",
    "bootstrap": "npm install && npm run build && npm run setup"
  },
  "devDependencies": {
    "firebase-tools": "^15.19.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
