{
  "name": "forward-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api-rest.d.ts",
      "import": "./dist/api-rest.js"
    },
    "./repo": {
      "types": "./dist/repo/index.d.ts",
      "import": "./dist/repo/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.12.0"
  }
}
