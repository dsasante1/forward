{
  "name": "forward-vscode",
  "displayName": "Forward",
  "version": "0.4.0",
  "type": "module",
  "publisher": "forward",
  "description": "Annotate a shared design canvas from VS Code — document any API (any language/framework), draw infrastructure & sequence-flow diagrams, track tasks, and browse endpoint history. Everything lives as plain JSON in your repository's .forward/ folder, so git is the sync and the history — and AI agents get the same tools through the Forward MCP server.",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsasante1/forward.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/dsasante1/forward/issues"
  },
  "homepage": "https://github.com/dsasante1/forward#readme",
  "keywords": [
    "api",
    "api-documentation",
    "documentation",
    "design",
    "architecture",
    "infrastructure",
    "diagram",
    "mermaid",
    "sequence-diagram",
    "tasks",
    "collaboration",
    "code-connect",
    "mcp",
    "ci",
    "api-docs"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:.forward/forward.json",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forward.connectEndpoint",
        "title": "Document API on Design Element",
        "category": "Forward"
      },
      {
        "command": "forward.insertAnchor",
        "title": "Insert Anchor at Cursor (@adc)",
        "category": "Forward"
      },
      {
        "command": "forward.openCanvas",
        "title": "Open Design Canvas",
        "category": "Forward",
        "icon": "$(open-preview)"
      },
      {
        "command": "forward.removeDocumentation",
        "title": "Remove API Documentation from Element",
        "category": "Forward"
      },
      {
        "command": "forward.addInfraNode",
        "title": "Add Infrastructure Node",
        "category": "Forward"
      },
      {
        "command": "forward.linkInfraNodes",
        "title": "Link Infrastructure Nodes",
        "category": "Forward"
      },
      {
        "command": "forward.removeInfraNode",
        "title": "Remove Infrastructure Node",
        "category": "Forward"
      },
      {
        "command": "forward.addFlow",
        "title": "Add Flow (Sequence Diagram)",
        "category": "Forward"
      },
      {
        "command": "forward.addFlowStep",
        "title": "Add Step to Flow",
        "category": "Forward"
      },
      {
        "command": "forward.removeFlow",
        "title": "Remove Flow",
        "category": "Forward"
      },
      {
        "command": "forward.addMcpServer",
        "title": "Add MCP Server",
        "category": "Forward"
      },
      {
        "command": "forward.removeMcpServer",
        "title": "Remove MCP Server",
        "category": "Forward"
      },
      {
        "command": "forward.addAgent",
        "title": "Add Agent",
        "category": "Forward"
      },
      {
        "command": "forward.removeAgent",
        "title": "Remove Agent",
        "category": "Forward"
      },
      {
        "command": "forward.createTask",
        "title": "Create Task",
        "category": "Forward"
      },
      {
        "command": "forward.updateTaskStatus",
        "title": "Update Task Status",
        "category": "Forward"
      },
      {
        "command": "forward.updateTask",
        "title": "Update Task (Schedule, Dependencies, Priority…)",
        "category": "Forward"
      },
      {
        "command": "forward.showTaskTimeline",
        "title": "Show Task Timeline (Gantt)",
        "category": "Forward"
      },
      {
        "command": "forward.validate",
        "title": "Validate Project",
        "category": "Forward"
      },
      {
        "command": "forward.showHistory",
        "title": "Show Endpoint Documentation History",
        "category": "Forward"
      },
      {
        "command": "forward.catchUp",
        "title": "Catch Up on Endpoint Changes",
        "category": "Forward"
      },
      {
        "command": "forward.setupMcp",
        "title": "Set Up MCP for AI Agents",
        "category": "Forward"
      },
      {
        "command": "forward.initRepo",
        "title": "Forward: Initialize Project in This Repository"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forward",
          "title": "Forward",
          "icon": "resources/forward.svg"
        }
      ]
    },
    "views": {
      "forward": [
        {
          "id": "forwardActions",
          "name": "Actions",
          "contextualTitle": "Forward"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "forward.insertAnchor",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "forward.openCanvas",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "forward.openCanvas",
          "when": "view == forwardActions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Forward",
      "properties": {
        "forward.openCanvasOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the Design Canvas automatically when VS Code starts (only when the workspace has a .forward/ project)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node e2e/run.mjs",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "forward-canvas": "*",
    "forward-core": "*",
    "ovsx": "^1.3.0",
    "playwright-core": "^1.61.1"
  }
}
