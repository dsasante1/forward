{
  "name": "forward-vscode",
  "displayName": "Forward",
  "version": "0.1.0",
  "type": "module",
  "publisher": "forward",
  "description": "Document any API (any language/framework) on your design canvas, synced through the Forward server.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsasante1/forward.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/dsasante1/forward/issues"
  },
  "homepage": "https://github.com/dsasante1/forward#readme",
  "keywords": [
    "api",
    "documentation",
    "design",
    "figma",
    "firebase",
    "code-connect"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forward.connectEndpoint",
        "title": "Document API on Design Element",
        "category": "Forward"
      },
      {
        "command": "forward.openCanvas",
        "title": "Open Design Canvas",
        "category": "Forward",
        "icon": "$(open-preview)"
      },
      {
        "command": "forward.removeDocumentation",
        "title": "Remove API Documentation from Element",
        "category": "Forward"
      },
      {
        "command": "forward.addInfraNode",
        "title": "Add Infrastructure Node",
        "category": "Forward"
      },
      {
        "command": "forward.linkInfraNodes",
        "title": "Link Infrastructure Nodes",
        "category": "Forward"
      },
      {
        "command": "forward.removeInfraNode",
        "title": "Remove Infrastructure Node",
        "category": "Forward"
      },
      {
        "command": "forward.addFlow",
        "title": "Add Flow (Sequence Diagram)",
        "category": "Forward"
      },
      {
        "command": "forward.addFlowStep",
        "title": "Add Step to Flow",
        "category": "Forward"
      },
      {
        "command": "forward.removeFlow",
        "title": "Remove Flow",
        "category": "Forward"
      },
      {
        "command": "forward.createTask",
        "title": "Create Task",
        "category": "Forward"
      },
      {
        "command": "forward.updateTaskStatus",
        "title": "Update Task Status",
        "category": "Forward"
      },
      {
        "command": "forward.signIn",
        "title": "Sign In (paste access token)",
        "category": "Forward"
      },
      {
        "command": "forward.signOut",
        "title": "Sign Out",
        "category": "Forward"
      },
      {
        "command": "forward.selectProject",
        "title": "Select Project",
        "category": "Forward"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "forward.openCanvas",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Forward",
      "properties": {
        "forward.apiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of your Forward server, e.g. http://localhost:8080 or https://api.forward.dev."
        },
        "forward.projectId": {
          "type": "string",
          "default": "",
          "description": "Project to annotate elements under. Use the “Forward: Select Project” command to pick one (it must match the canvas VITE_CANVAS_PROJECT_ID)."
        },
        "forward.openCanvasOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the read-only Design Canvas automatically when VS Code starts (only if the server URL and project id are set)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "forward-core": "*",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.5",
    "ovsx": "^0.10.0"
  }
}
