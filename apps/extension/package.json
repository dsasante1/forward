{
  "name": "api-design-connector-extension",
  "displayName": "API Design Connector",
  "version": "0.1.0",
  "type": "module",
  "publisher": "adc",
  "description": "Document any API (any language/framework) on your design canvas via your own Firebase RTDB.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsasante1/figma_design_api_documentation_project.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/dsasante1/figma_design_api_documentation_project/issues"
  },
  "homepage": "https://github.com/dsasante1/figma_design_api_documentation_project#readme",
  "keywords": [
    "api",
    "documentation",
    "design",
    "figma",
    "firebase",
    "code-connect"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "api-design-connector.connectEndpoint",
        "title": "Document API on Design Element",
        "category": "API Design Connector"
      },
      {
        "command": "api-design-connector.openCanvas",
        "title": "Open Design Canvas",
        "category": "API Design Connector",
        "icon": "$(open-preview)"
      },
      {
        "command": "api-design-connector.removeDocumentation",
        "title": "Remove API Documentation from Element",
        "category": "API Design Connector"
      },
      {
        "command": "api-design-connector.addInfraNode",
        "title": "Add Infrastructure Node",
        "category": "API Design Connector"
      },
      {
        "command": "api-design-connector.linkInfraNodes",
        "title": "Link Infrastructure Nodes",
        "category": "API Design Connector"
      },
      {
        "command": "api-design-connector.removeInfraNode",
        "title": "Remove Infrastructure Node",
        "category": "API Design Connector"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "api-design-connector.openCanvas",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "API Design Connector",
      "properties": {
        "apiDesignConnector.firebaseDatabaseUrl": {
          "type": "string",
          "default": "",
          "description": "Your Firebase Realtime Database URL (BYOD)."
        },
        "apiDesignConnector.projectId": {
          "type": "string",
          "default": "",
          "description": "Canvas project id to annotate elements under (must match the canvas VITE_CANVAS_PROJECT_ID)."
        },
        "apiDesignConnector.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional Firebase auth token / DB secret, used when your RTDB rules require auth. Leave blank for test-mode (open) rules."
        },
        "apiDesignConnector.openCanvasOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the read-only Design Canvas automatically when VS Code starts (only if the database URL and project id are set)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@adc/shared": "*",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.5",
    "ovsx": "^0.10.0"
  }
}
