# --- Forward backend configuration (never commit the filled-in .env) ---

# Supabase Postgres connection. Use the *pooled* connection string for the app
# (Supabase → Project Settings → Database → Connection string → "Transaction"),
# and the direct one for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project — used to broadcast realtime change events to clients.
SUPABASE_URL="https://<ref>.supabase.co"
# Service-role key stays server-side ONLY. Clients use the anon key to subscribe.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Clerk — backend verifies the per-user session token on every request.
CLERK_SECRET_KEY="sk_test_xxx"
# Optional: restrict which front-end origins may obtain a verified session.
CLERK_AUTHORIZED_PARTIES="http://localhost:5173,https://app.yourdomain.com"

# Email notifications (Mailtrap Email Sending API). Secret — server-side only.
MAILTRAP_API_KEY="<mailtrap-sending-token>"
# Default sender. Format: "Name <email@domain>" or a bare "email@domain".
DEFAULT_FROM_EMAIL="Forward <no-reply@example.com>"
# Optional: override the send endpoint (e.g. the Mailtrap sandbox API).
# MAILTRAP_API_URL="https://send.api.mailtrap.io/api/send"

# HTTP
PORT="8080"
CORS_ORIGINS="http://localhost:5173,https://app.yourdomain.com"
# Public URL of the dashboard — used to build invitation accept links in emails.
APP_BASE_URL="http://localhost:5173"
