# --- Forward backend configuration (never commit the filled-in .env) ---

# Supabase Postgres connection. Use the *session* pooler (port 5432) for the app:
# the server runs interactive transactions with SET LOCAL (RLS via app.user_id),
# which need a session-pinned connection. The transaction pooler (6543) breaks
# them with "Transaction not found / Transaction ID is invalid".
# (Supabase → Project Settings → Database → Connection string → "Session".)
# Size the Prisma pool explicitly: the default (num_cpus*2+1) is 3 on a 1-vCPU
# Cloud Run instance, which a burst of concurrent requests exhausts instantly
# (every handler holds a connection for its interactive transaction).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project — used to broadcast realtime change events to clients.
SUPABASE_URL="https://<ref>.supabase.co"
# Service-role key stays server-side ONLY. Clients use the anon key to subscribe.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Optional: secret used to derive the unguessable per-project realtime channel
# name (a broadcast channel isn't access-controlled, so the name is the member
# capability). Defaults to CLERK_SECRET_KEY; set this to rotate channel names
# independently. Must be identical across all server instances.
REALTIME_CHANNEL_SECRET="<random-string>"

# Clerk — backend verifies the per-user session token on every request.
CLERK_SECRET_KEY="sk_test_xxx"
# Optional: restrict which front-end origins may obtain a verified session.
CLERK_AUTHORIZED_PARTIES="http://localhost:5173,https://app.yourdomain.com"
# Clerk webhook signing secret (Clerk Dashboard → Webhooks → your endpoint).
# Verifies the Svix signature on POST /webhooks/clerk, which mirrors users and
# organizations into Postgres. Format: "whsec_…".
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"

# Email notifications (Mailtrap Email Sending API). Secret — server-side only.
MAILTRAP_API_KEY="<mailtrap-sending-token>"
# Default sender. Format: "Name <email@domain>" or a bare "email@domain".
DEFAULT_FROM_EMAIL="Forward <no-reply@example.com>"
# Optional: override the send endpoint (e.g. the Mailtrap sandbox API).
# MAILTRAP_API_URL="https://send.api.mailtrap.io/api/send"

# HTTP
PORT="8080"
CORS_ORIGINS="http://localhost:5173,https://app.yourdomain.com"
# Public URL of the dashboard — used to build invitation accept links in emails.
APP_BASE_URL="http://localhost:5173"

# Cloud Tasks — offloads background jobs (e.g. sending email) onto a managed
# queue that delivers them back to this service at POST /internal/jobs/*, so
# side effects stay off the request's critical path and get retries/backoff.
# All five must be set to enable the queue; if any is missing the server falls
# back to a non-blocking inline send (fine for local dev). The runtime service
# account needs the "cloudtasks.enqueuer" IAM role.
# GCP_PROJECT_ID="forward-500820"
# CLOUD_TASKS_LOCATION="us-central1"
# CLOUD_TASKS_QUEUE="forward-email"
# Public base URL of THIS service (its Cloud Run URL) — Cloud Tasks POSTs jobs
# here, and it is also the OIDC audience the job handler verifies.
# CLOUD_TASKS_SERVICE_URL="https://forward-server-xxxx.run.app"
# Service account Cloud Tasks mints the request's OIDC token as. The job handler
# verifies the token's signature/audience and that its email claim matches this.
# CLOUD_TASKS_INVOKER_SA="forward-tasks-invoker@<project>.iam.gserviceaccount.com"
