// Forward backend data model — Supabase Postgres.
//
// This is the centralized translation of the old Firebase RTDB tree (see the
// `paths` map in packages/shared/src/schema.ts). The flexible per-layer shapes
// (DesignElement, InfraNode, …) live in `data Json` columns and are validated on
// write by the SAME forward-core Zod schemas the canvas/extension/MCP use, so the
// contract stays single-sourced. The relational columns carry only what we query
// or enforce on: tenancy (projectId), identity (userId/author), ordering, time.
//
// Tenancy is enforced in the service layer on every query; enable Postgres RLS in
// a follow-up migration as defense-in-depth (see prisma/rls.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  viewer
  editor
  owner
}

// A user's role *within an organization* — the tenancy tier above the project.
// Mirrored from Clerk Organizations (the `org_role` session claim). An `admin`
// runs the Org Admin portal for that org; a `member` just belongs. See OrgRole
// in forward-core.
enum OrgRole {
  admin
  member
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

// Subscription tier of an organization. Drives the Org list/detail in the staff
// admin console (plan badge, seat limits). No payment provider is wired yet, so
// the plan is set manually by a platform admin; pricing/MRR is not derived here.
enum Plan {
  solo
  team
  enterprise
}

// A user, keyed by their Clerk user id (we do not store passwords — Clerk owns auth).
model User {
  id            String          @id // Clerk user id, e.g. "user_2abc..."
  email         String?
  // Display profile mirrored from Clerk so the member roster can show a person,
  // not a raw "user_..." id. Synced on every authenticated touch (see
  // ClerkUserService.sync); nullable because Clerk may be unreachable when the
  // FK-target User row is first created.
  name          String?
  imageUrl      String?
  // Platform superadmin flag. The ONE deliberate exception to "no client carries
  // admin powers" (clerk-auth.guard.ts): a true value lets PlatformAdminGuard
  // admit this user to the cross-tenant `/admin/*` API that operates the hosted
  // product. Default false; granted only by another platform admin.
  isPlatformAdmin Boolean        @default(false)
  // When set, the account is suspended: ClerkAuthGuard rejects every request.
  // Set/cleared from the platform admin portal; never by the user themselves.
  suspendedAt   DateTime?
  // Last time we saw an authenticated request from this user — bumped
  // fire-and-forget by ClerkAuthGuard. Powers the "last seen" column in the
  // staff console (cheap local stamp instead of a Clerk round-trip per row).
  lastSeenAt    DateTime?
  createdAt     DateTime        @default(now())
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  orgMemberships OrganizationMember[]
  apiTokens     ApiToken[]
}

// An organization = the tenancy tier above the project, and the unit the Org
// Admin portal manages. Clerk Organizations is the source of truth for the org
// and its membership/roles; this row (and OrganizationMember) is a local mirror
// kept in step by the Clerk webhook (webhooks.controller.ts) so the server can
// JOIN projects→org and query an org's content without a Clerk round-trip. The
// id is the Clerk organization id (e.g. "org_2abc…").
model Organization {
  id          String               @id // Clerk organization id
  name        String
  slug        String?
  imageUrl    String?
  // Subscription tier + seat cap, set manually by a platform admin (no billing
  // provider yet). `seatLimit` null = unlimited; the staff console compares it to
  // the member count to flag orgs at their limit. `region` is informational only.
  plan        Plan                 @default(solo)
  seatLimit   Int?
  region      String?
  // When set, the org is suspended: members are denied access to its projects.
  // Set/cleared from the platform admin portal.
  suspendedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  projects    Project[]
}

// Per-org membership mirror (Clerk owns the truth; synced via webhook). Drives
// the Org Admin portal's "is this caller an admin of this org" checks server-side
// and lets us list an org's people without calling Clerk.
model OrganizationMember {
  orgId   String
  userId  String
  role    OrgRole      @default(member)
  addedAt DateTime     @default(now())
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
}

// Append-only audit trail of privileged actions taken in the Org Admin and
// Platform Admin portals (transfer ownership, suspend a user, revoke a member's
// token, …). INSERT ONLY, server-stamped — the tamper-evident record the
// recommendation requires. `scope` separates org-admin from platform-admin acts.
model AdminAuditEvent {
  id         String   @id @default(cuid())
  scope      String // 'org' | 'platform'
  orgId      String? // set for scope='org'
  actorId    String // Clerk uid of the admin who acted
  action     String // e.g. 'project.transfer', 'user.suspend', 'token.revoke'
  targetType String // 'project' | 'user' | 'org' | 'token'
  targetId   String
  detail     String   @default("")
  ts         BigInt // epoch ms
  createdAt  DateTime @default(now())

  @@index([scope, ts])
  @@index([orgId, ts])
  @@index([targetType, targetId])
}

// A long-lived Personal Access Token, the headless surfaces' (VS Code extension,
// CLIs) credential. Clerk session JWTs are short-lived and browser-bound; a PAT
// lets a non-browser client authenticate as its owner without the god-secret the
// old Firebase extension carried. The plaintext is shown once at creation and
// only its sha256 hash is stored; ClerkAuthGuard resolves a `fwd_pat_` bearer
// token to this row's `userId`, so the PAT grants exactly its owner's access.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String // user label, e.g. "Work laptop"
  tokenHash  String    @unique // sha256(plaintext), hex
  prefix     String // first chars for display, e.g. "fwd_pat_8f2a…"
  lastUsedAt DateTime?
  expiresAt  DateTime? // null = no expiry
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A project = the tenancy boundary (the old RTDB "project id" namespace).
model Project {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  // The organization this project belongs to (the tenancy tier the Org Admin
  // portal manages). Nullable: personal projects, and any project created before
  // an org was active, have no org. Set from the caller's active Clerk org claim
  // at create time. onDelete:SetNull so deleting an org orphans, not destroys.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  // Last time the project's *content* changed (renamed, or any element/infra/task
  // edit bumps it) — drives the "edited" stamp on the projects dashboard.
  updatedAt DateTime @updatedAt

  members        ProjectMember[]
  invites        Invite[]
  elements       DesignElement[]
  versionEntries VersionEntry[]
  timelineEvents TimelineEvent[]
  infraNodes     InfraNode[]
  infraEdges     InfraEdge[]
  infraFlows     InfraFlow[]
  entities         Entity[]
  entityRelations  EntityRelation[]
  agentNodes       AgentNode[]
  mcpServers       McpServer[]
  tasks          Task[]
  checkpoints    Checkpoint[]

  @@index([ownerId])
  @@index([organizationId])
}

// Per-project membership roster — replaces project_members + the Firebase rules ACL.
model ProjectMember {
  projectId String
  userId    String
  role      Role     @default(editor)
  // Per-user "star" on the projects dashboard. Belongs on the membership because
  // it is a (user, project) fact — each member pins independently of the others.
  favorite  Boolean  @default(false)
  addedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// A pending email invitation to a project. The owner creates it; the backend
// emails a link carrying the opaque `token`; the invitee signs in and accepts,
// which creates the ProjectMember row and marks the invite `accepted`.
model Invite {
  id        String       @id @default(cuid())
  projectId String
  email     String
  role      Role         @default(editor)
  token     String       @unique
  status    InviteStatus @default(pending)
  invitedBy String // Clerk uid of the owner who sent it
  createdAt DateTime     @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([email])
}

// A design element (frame/rectangle/text/component/instance) + its optional
// apiBinding. Full shape validated by forward-core `DesignElement`.
model DesignElement {
  projectId String
  id        String
  data      Json // DesignElement (geometry, style, apiBinding, …)
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

// The append-only documentation history (old version_timeline). INSERT ONLY:
// the service never updates or deletes these, and no route exposes a mutation.
// `author` + `ts` are stamped by the server from the authenticated session.
model VersionEntry {
  seq       BigInt   @id @default(autoincrement())
  projectId String
  elementId String
  data      Json // forward-core VersionEntry (changeLog, diff, endpoint snapshot…)
  author    String
  ts        BigInt // epoch ms — mirrors VersionEntry.timestamp
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, elementId])
  @@index([projectId, ts])
}

// The unified, project-wide activity feed behind the canvas History timeline.
// Append-only like VersionEntry (INSERT only — no route mutates it): the element
// and infra services record one row per create/modify/delete, domain-tagged, so
// the History view has a real event for every layer. `author` + `ts` are stamped
// by the server from the authenticated session.
model TimelineEvent {
  seq       BigInt   @id @default(autoincrement())
  projectId String
  domain    String // 'design' | 'api' | 'infra' | 'uml'
  action    String // 'created' | 'modified' | 'deleted'
  targetId  String // element / node / edge / flow id
  title     String
  detail    String   @default("")
  author    String
  ts        BigInt // epoch ms
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, ts])
}

model InfraNode {
  projectId String
  id        String
  data      Json // forward-core InfraNode
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

model InfraEdge {
  projectId String
  id        String
  data      Json // forward-core InfraEdge
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

model InfraFlow {
  projectId String
  id        String
  data      Json // forward-core InfraFlow
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

// An ER-diagram entity (table/model + its fields). Standalone data-model layer,
// separate from the infra graph. Full shape validated by forward-core `Entity`.
model Entity {
  projectId String
  id        String
  data      Json // forward-core Entity
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

// A crow's-foot association between two entities. Validated by forward-core
// `EntityRelation`.
model EntityRelation {
  projectId String
  id        String
  data      Json // forward-core EntityRelation
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

// An agent the project defines (model + system prompt + the MCP servers it's
// wired to). Standalone Agent/MCP layer, separate from the infra graph. Full
// shape validated by forward-core `AgentNode`.
model AgentNode {
  projectId String
  id        String
  data      Json // forward-core AgentNode
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

// An MCP server the project exposes or consumes (transport + the tools it
// exposes, each optionally wrapping a documented endpoint). Validated by
// forward-core `McpServerNode`.
model McpServer {
  projectId String
  id        String
  data      Json // forward-core McpServerNode
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

model Task {
  projectId String
  id        String
  data      Json // forward-core Task
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
}

// A manual, named snapshot of the canvas (pillar 5). `data` is the full
// forward-core Checkpoint, including the frozen design + infra `snapshot`.
model Checkpoint {
  projectId String
  id        String
  data      Json // forward-core Checkpoint
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId, createdAt])
}
