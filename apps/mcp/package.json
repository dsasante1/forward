{
  "name": "forward-mcp",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Forward for AI agents: an MCP server and the `forward` CLI over a design + API-docs project stored in your git repo.",
  "license": "Apache-2.0",
  "bin": {
    "forward-mcp": "dist/server.js",
    "forward": "dist/cli.js"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack": "node scripts/pack.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "forward-core": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.61.1"
  }
}
