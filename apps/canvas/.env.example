# Canvas config (BYOD). Copy to `.env.local` (gitignored) and fill in.
#
# Source selection priority: mock > live Firebase > offline fixture.
# Leave everything unset and the canvas runs offline off the fixture.

# --- Option A: local mock RTDB (end-to-end testing, no cloud) ---------------
# Start the mock with `npm run mock` at the repo root, then set this. When set,
# it takes priority over the Firebase config below.
# VITE_MOCK_RTDB_URL=http://localhost:9000

# --- Option B: live Firebase ------------------------------------------------
# Find these in Firebase console → Project settings → "Your apps" (Web app).
# Required: your Realtime Database URL.
VITE_FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# Required for Anonymous Auth (locked rules). Optional for test-mode (open) rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR-PROJECT
VITE_FIREBASE_APP_ID=

# Set "true" once you've enabled Anonymous sign-in and deployed the locked rules.
# Keep "false" while testing against open (test-mode) rules.
VITE_FIREBASE_USE_ANON_AUTH=false

# The namespace within the DB tree that this canvas reads/writes. Must match the
# extension's forward.projectId setting so both sides share elements.
VITE_CANVAS_PROJECT_ID=project_xyz
