          "changeLog": "Strict regex validation now enforced on the email field.",
          "endpoint": {
            "title": "Log in",
            "method": "POST",
            "path": "/api/v1/users/login"
          },
          "diff": {
            "added": 2,
            "removed": 1,
            "breaking": "Breaking for malformed input. Clients sending non-conforming emails now receive 422 instead of 200.",
            "sections": [
              {
                "label": "request · body.email",
                "rows": [
                  { "op": "unchanged", "cols": ["email", "string", "required"] },
                  { "op": "removed", "cols": ["format", "—", "any non-empty string accepted"] },
                  { "op": "added", "cols": ["format", "regex", "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"] }
                ]
              },
              {
                "label": "responses",
                "rows": [
                  { "op": "unchanged", "cols": ["200", "OK", "{ token, expiresIn }"] },
                  { "op": "added", "cols": ["422", "error", "INVALID_EMAIL — email failed validation"] }
                ]
              }
            ]
          }
        }
      ],
