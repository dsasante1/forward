# Clerk publishable key for the admin app. Use a Clerk instance/app whose users
# are Forward staff; access is still gated server-side by User.isPlatformAdmin.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Base URL of the Forward backend (apps/server). No trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Deploy environment shown in the topbar badge: development | staging | production.
# Defaults to "development" when unset.
VITE_ENV=development
