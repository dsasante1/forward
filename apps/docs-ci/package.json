{
  "name": "forward-docs-ci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CI write step: validate an AI-produced forward-docs.json and write it into the repository's .forward/ project. The AI is bring-your-own; this step runs no AI and needs no credentials.",
  "license": "Apache-2.0",
  "bin": {
    "forward-docs": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "forward-core": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "esbuild": "^0.28.2"
  }
}
