# Clerk frontend publishable key (pk_test_… / pk_live_…). Safe to ship to the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Base URL of the Forward backend (apps/server). No trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Supabase Realtime (optional — live updates). Use the PUBLIC publishable/anon
# key, never the service-role secret. Leave blank to disable realtime.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
